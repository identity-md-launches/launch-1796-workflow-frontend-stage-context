{
  "name": "lastword-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/export-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "node scripts/verify-export.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.4.0",
    "@tanstack/react-query": "^5.104.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.7",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
